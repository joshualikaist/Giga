<?xml version="1.0"?>
<!--
  simple_biped.urdf — 교육용 최소 2족 로봇 (6 자유도, 총 질량 8.2 kg)
  상세 사양: docs/04_simple_biped_spec.md

  링크/관절 트리:
    base_link (몸통 4.0 kg)
     ├─ left_hip_pitch   → left_thigh  (1.0 kg)
     │   └─ left_knee        → left_shin   (0.8 kg)
     │       └─ left_ankle_pitch → left_foot (0.3 kg)
     └─ right_hip_pitch  → right_thigh (1.0 kg)
         └─ right_knee       → right_shin  (0.8 kg)
             └─ right_ankle_pitch → right_foot (0.3 kg)

  좌표계: x = 앞, y = 왼쪽, z = 위 (ROS REP-103 = MuJoCo 동일). 단위: m, kg, rad, N·m, s
  모든 관절은 y축 회전(pitch). 부호 규약 (오른손 법칙, +y축 기준):
    hip_pitch  (+) 다리가 뒤로 / (-) 다리가 앞으로 (굽힘)
    knee       (+) 무릎 굽힘   (0 = 쭉 편 상태)
    ankle_pitch(+) 발끝이 아래로 / (-) 발끝이 위로
  → hip = -a, knee = 2a, ankle = -a 이면 발바닥이 수평이고 발목이 고관절 바로 아래에 옵니다.

  주의: 이 로봇은 hip roll 관절이 없어 좌우로 체중을 옮길 수 없습니다.
        "URDF → MuJoCo → 서 있기"를 배우기 위한 모델이며, 3D 보행용 모델은 로드맵 Phase 4에서 다룹니다.
-->
<robot name="simple_biped">

  <!-- ===================================================================
       MuJoCo 전용 확장 태그
       ROS2의 URDF 파서(urdfdom)는 모르는 태그를 무시하므로, 같은 파일을
       robot_state_publisher / RViz에서도 그대로 쓸 수 있습니다.
         discardvisual="false" : <visual> geom을 버리지 않음 (기본값 true → 색상이 사라짐)
         fusestatic="false"    : 관절 없는 링크(루트 포함)를 부모에 병합하지 않음
                                 (기본값 true → base_link가 world에 흡수되어 사라짐!)
       =================================================================== -->
  <mujoco>
    <compiler discardvisual="false" fusestatic="false"/>
  </mujoco>

  <!-- 색상 정의 (MuJoCo는 <visual>의 material color를 geom 색상으로 가져옵니다) -->
  <material name="torso_gray"><color rgba="0.75 0.75 0.8 1"/></material>
  <material name="left_blue"><color rgba="0.25 0.45 0.9 1"/></material>
  <material name="right_red"><color rgba="0.9 0.35 0.3 1"/></material>
  <material name="foot_dark"><color rgba="0.25 0.25 0.25 1"/></material>

  <!-- =========================== 몸통 =========================== -->
  <!-- base_link 원점 = 몸통 박스의 중심. 고관절은 박스 아래면(z = -0.10)에 위치 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <!-- inertia_calc.py box 4.0 0.12 0.22 0.20 -->
      <inertia ixx="0.0294667" ixy="0" ixz="0" iyy="0.0181333" iyz="0" izz="0.0209333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.22 0.20"/></geometry>
      <material name="torso_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.22 0.20"/></geometry>
    </collision>
  </link>

  <!-- =========================== 왼다리 =========================== -->
  <link name="left_thigh">
    <inertial>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <mass value="1.0"/>
      <!-- inertia_calc.py cylinder 1.0 0.03 0.25 -->
      <inertia ixx="0.00543333" ixy="0" ixz="0" iyy="0.00543333" iyz="0" izz="0.00045"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.25"/></geometry>
      <material name="left_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.25"/></geometry>
    </collision>
  </link>

  <joint name="left_hip_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="left_thigh"/>
    <origin xyz="0 0.07 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- effort  = 최대 토크 [N·m] → MuJoCo joint의 actuatorfrcrange 로 변환됨
         velocity = 최대 속도 [rad/s] → MuJoCo는 이 값을 "무시"함 (제어기에서 직접 제한해야 함) -->
    <limit lower="-1.57" upper="0.52" effort="20.0" velocity="10.0"/>
    <!-- damping → MuJoCo damping, friction → MuJoCo frictionloss -->
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <link name="left_shin">
    <inertial>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <mass value="0.8"/>
      <!-- inertia_calc.py cylinder 0.8 0.025 0.25 -->
      <inertia ixx="0.00429167" ixy="0" ixz="0" iyy="0.00429167" iyz="0" izz="0.00025"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.25"/></geometry>
      <material name="left_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.25"/></geometry>
    </collision>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.36" effort="20.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <link name="left_foot">
    <inertial>
      <!-- 발은 발목보다 3 cm 앞으로 나와 있음 (앞쪽 지지 면적을 넓히기 위함) -->
      <origin xyz="0.03 0 -0.015" rpy="0 0 0"/>
      <mass value="0.3"/>
      <!-- inertia_calc.py box 0.3 0.16 0.08 0.03 -->
      <inertia ixx="0.0001825" ixy="0" ixz="0" iyy="0.0006625" iyz="0" izz="0.0008"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 -0.015" rpy="0 0 0"/>
      <geometry><box size="0.16 0.08 0.03"/></geometry>
      <material name="foot_dark"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 -0.015" rpy="0 0 0"/>
      <geometry><box size="0.16 0.08 0.03"/></geometry>
    </collision>
  </link>

  <joint name="left_ankle_pitch" type="revolute">
    <parent link="left_shin"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.79" upper="0.79" effort="10.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <!-- =========================== 오른다리 (왼다리와 y만 반대) =========================== -->
  <link name="right_thigh">
    <inertial>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00543333" ixy="0" ixz="0" iyy="0.00543333" iyz="0" izz="0.00045"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.25"/></geometry>
      <material name="right_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.25"/></geometry>
    </collision>
  </link>

  <joint name="right_hip_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="right_thigh"/>
    <origin xyz="0 -0.07 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0.52" effort="20.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <link name="right_shin">
    <inertial>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.00429167" ixy="0" ixz="0" iyy="0.00429167" iyz="0" izz="0.00025"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.25"/></geometry>
      <material name="right_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.25"/></geometry>
    </collision>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.36" effort="20.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <link name="right_foot">
    <inertial>
      <origin xyz="0.03 0 -0.015" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0001825" ixy="0" ixz="0" iyy="0.0006625" iyz="0" izz="0.0008"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 -0.015" rpy="0 0 0"/>
      <geometry><box size="0.16 0.08 0.03"/></geometry>
      <material name="foot_dark"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 -0.015" rpy="0 0 0"/>
      <geometry><box size="0.16 0.08 0.03"/></geometry>
    </collision>
  </link>

  <joint name="right_ankle_pitch" type="revolute">
    <parent link="right_shin"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.79" upper="0.79" effort="10.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

</robot>
